# Neon PostgreSQL connection string (pooled — goes through Neon's PgBouncer,
# safe for many concurrent serverless function connections).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/drim_inventory?sslmode=require"

# Unpooled connection — required by prisma/schema.prisma's directUrl for
# `prisma migrate`, which can't run reliably through a connection pooler.
# In Neon's dashboard this is the "Direct connection" string (same host,
# no "-pooler" in it). Only used for migrations, not normal app queries.
DIRECT_URL="postgresql://user:password@host.neon.tech/drim_inventory?sslmode=require"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Cloudflare R2 (product images, generated PDF report exports)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Sentry error tracking. Leave blank to disable entirely — every Sentry.init()
# call in this app treats an empty DSN as a safe no-op, so this whole block is
# optional until you actually want error reporting turned on.
# 1. Create a free project at https://sentry.io (Platform: Next.js).
# 2. Paste its DSN below (Settings > Projects > <project> > Client Keys).
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed for source-map upload at build time (readable stack traces in
# Sentry instead of minified ones) — from Settings > Organization/Project.
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token for the upload step: Settings > Auth Tokens > Create New Token
# (needs the project:releases scope). Keep this secret — set it in Vercel's
# env vars, never commit a real value.
SENTRY_AUTH_TOKEN=""

# Upstash Redis — shared store for rate limiting (login attempts, password
# changes, mutations) so limits actually hold across Vercel's serverless
# instances/cold starts. Leave blank to fall back to an in-memory limiter
# that resets on every cold start (fine for local dev, not for production).
# 1. Create a free database at https://upstash.com (no card required) —
#    pick the same region as your Neon DB for lowest latency.
# 2. Copy these two values from its dashboard (REST API section).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

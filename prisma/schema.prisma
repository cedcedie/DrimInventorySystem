generator client {
  provider = "prisma-client-js"
  // Custom output so types resolve under pnpm (default @prisma/client/.prisma path breaks).
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  WAREHOUSE_STAFF
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MrfStatus {
  PENDING
  PARTIAL // NEW: Some items fulfilled, some pending
  FULFILLED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT // being built, not yet sent to the supplier
  SENT // sent to supplier, awaiting delivery
  PARTIALLY_RECEIVED // some items received via a linked Stock In batch
  RECEIVED // fully received
  CANCELLED
}

// NEW: Internal request that precedes a Purchase Order — DRIM's real process
// is PR (raised internally) -> Owner/Admin approval -> PO (sent to supplier).
// Kept separate from PurchaseOrder rather than reusing PurchaseOrderStatus
// because the two have different lifecycles (a PR either dies at
// rejected/cancelled or becomes exactly one PO; a PO tracks delivery after
// that point) and different actors gate each transition.
enum PurchaseRequestStatus {
  PENDING // filed, awaiting Owner/Admin decision
  APPROVED // approved and converted to a PurchaseOrder in the same step
  REJECTED // declined with a reason
  CANCELLED // withdrawn by the requester before a decision
}

enum AdjustmentReason {
  MISCOUNT // physical count didn't match the system
  DAMAGED // goods damaged or otherwise unusable
  LOST // missing, no explanation found
  FOUND // stock located that the system didn't know about
  RETURN // returned unused from a project
  CORRECTION // fixing a data-entry mistake
}

model User {
  id                       String            @id @default(cuid())
  username                 String            @unique
  passwordHash             String
  name                     String
  role                     Role
  status                   UserStatus        @default(ACTIVE)
  avatarKey                String? // Blob key from the same store as product images (see storage.ts)
  permissionOverrides      Json? // NEW: User-specific permission overrides
  activities               ActivityLog[]
  stockInBatches           StockInBatch[]
  stockOuts                StockOut[]
  adjustments              StockAdjustment[]
  settingsEdits            CompanySettings[]
  technician               Technician?
  permissions              Permission[] // NEW: Direct permissions
  notifications            Notification[]
  sentNotifications        Notification[]    @relation("NotificationSender")
  purchaseOrders           PurchaseOrder[]
  purchaseRequests         PurchaseRequest[] @relation("PurchaseRequestRequester")
  purchaseRequestDecisions PurchaseRequest[] @relation("PurchaseRequestDecider")
  createdAt                DateTime          @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id               String            @id @default(cuid())
  name             String            @unique
  contact          String // phone or email
  supplies         String // free-text description
  products         Product[]
  stockInBatches   StockInBatch[]
  purchaseOrders   PurchaseOrder[]
  purchaseRequests PurchaseRequest[]
}

model Product {
  id                   String                @id @default(cuid())
  code                 String                @unique // e.g. PIP-012 (prefix per category)
  name                 String
  description          String?               @db.Text // NEW: Detailed product description/specs
  categoryId           String
  category             Category              @relation(fields: [categoryId], references: [id])
  unit                 String // Pcs | Meter | ...
  amount               Decimal?              @db.Decimal(12, 2) // CHANGED: Optional unit price (hidden from most users)
  stocks               Int                   @default(0)
  minLevel             Int                   @default(0) // low-stock threshold
  supplierId           String?
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  imageKey             String? // R2 object key
  archivedAt           DateTime? // Soft-archive — keeps SI/SO/MRF history; hidden from active catalog
  stockIns             StockIn[]
  stockOuts            StockOut[]
  mrfItems             MrfItem[] // NEW: Changed from mrfs to mrfItems
  adjustments          StockAdjustment[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseRequestItems PurchaseRequestItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([archivedAt])
}

model Technician {
  id        String     @id @default(cuid())
  empNo     String     @unique // EMP-0147
  name      String
  position  String // HVAC Technician, Refrigeration Engineer
  userId    String?    @unique // links to the login account that files MRFs as this technician
  user      User?      @relation(fields: [userId], references: [id])
  mrfs      Mrf[]
  stockOuts StockOut[]
}

model Mrf {
  id            String     @id @default(cuid())
  refNo         String     @unique // MRF-118 (system-generated)
  externalRefNo String? // NEW: Optional external/manual MRF number
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id])
  project       String // e.g. Northgate Cold Storage
  description   String?    @db.Text // NEW: MRF-level notes/description
  status        MrfStatus  @default(PENDING)
  items         MrfItem[] // NEW: Multiple items per MRF
  stockOuts     StockOut[] // NEW: Can have multiple fulfillments
  createdAt     DateTime   @default(now())

  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
  @@index([externalRefNo])
}

// NEW: Individual items within an MRF (supports multi-item requests)
model MrfItem {
  id           String     @id @default(cuid())
  mrfId        String
  mrf          Mrf        @relation(fields: [mrfId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qtyRequested Int // What the technician asked for
  qtyFulfilled Int        @default(0) // What has been fulfilled so far (can be partial)
  notes        String? // Item-specific notes
  stockOuts    StockOut[] // Fulfillments for this item

  @@index([mrfId])
  @@index([productId])
}

// A single delivery receipt. One SI-#### ref can cover several products
// received from the same supplier in one batch (NEW: was one-item-per-refNo).
model StockInBatch {
  id              String         @id @default(cuid())
  refNo           String         @unique // SI-0442, shared by every item in the batch
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  byUserId        String
  byUser          User           @relation(fields: [byUserId], references: [id])
  createdAt       DateTime       @default(now())
  items           StockIn[]
  // Optional — a delivery can arrive against a PO (expected shipment) or
  // stand alone (an unplanned/ad-hoc receipt), same as today.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([supplierId])
  @@index([byUserId])
  @@index([createdAt])
  @@index([purchaseOrderId])
}

// What's on order from a supplier but not yet (fully) received — closes the
// gap where Stock In was purely reactive to whatever already arrived, with
// no visibility into what's already inbound before deciding to reorder.
model PurchaseOrder {
  id              String              @id @default(cuid())
  refNo           String              @unique // PO-0001
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?             @db.Text
  byUserId        String
  byUser          User                @relation(fields: [byUserId], references: [id])
  createdAt       DateTime            @default(now())
  items           PurchaseOrderItem[]
  stockInBatches  StockInBatch[]
  // Set when this PO was created by approving a PurchaseRequest rather than
  // filed directly — back-reference lives on PurchaseRequest (it owns the
  // unique FK) so a PO doesn't need to know it came from a PR to function.
  purchaseRequest PurchaseRequest?

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  qtyOrdered      Int
  qtyReceived     Int           @default(0)

  @@index([purchaseOrderId])
  @@index([productId])
}

// NEW: Internal "we need to order this" request that precedes a PO. Raised
// by Owner/Admin/Warehouse Staff, decided by Owner/Admin — approval creates
// the PurchaseOrder atomically in the same transaction (see
// POST /api/purchase-requests/[id]/decide), so PENDING -> APPROVED and the
// PO's existence happen together or not at all.
model PurchaseRequest {
  id              String                @id @default(cuid())
  refNo           String                @unique // PR-0001
  // Optional — a requester may know what's needed without yet knowing which
  // supplier to buy it from; the approver picks/confirms the supplier at
  // decision time, when it becomes required to convert to a PO.
  supplierId      String?
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  status          PurchaseRequestStatus @default(PENDING)
  notes           String?               @db.Text
  byUserId        String
  byUser          User                  @relation("PurchaseRequestRequester", fields: [byUserId], references: [id])
  decidedById     String?
  decidedBy       User?                 @relation("PurchaseRequestDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  // Rejection reason, or an optional note left on approval.
  decisionNote    String?               @db.Text
  purchaseOrderId String?               @unique
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime              @default(now())
  items           PurchaseRequestItem[]

  @@index([status])
  @@index([byUserId])
  @@index([createdAt])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  qtyRequested      Int

  @@index([purchaseRequestId])
  @@index([productId])
}

model StockIn {
  id             String       @id @default(cuid())
  stockInBatchId String
  stockInBatch   StockInBatch @relation(fields: [stockInBatchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  qty            Int
  createdAt      DateTime     @default(now())

  @@index([stockInBatchId])
  @@index([productId])
}

model StockOut {
  id           String     @id @default(cuid())
  refNo        String     @unique // SO-0290
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  mrfId        String? // CHANGED: Non-unique (multiple stock-outs per MRF)
  mrf          Mrf?       @relation(fields: [mrfId], references: [id])
  mrfItemId    String? // NEW: Link to specific MRF item
  mrfItem      MrfItem?   @relation(fields: [mrfItemId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  qty          Int
  byUserId     String
  byUser       User       @relation(fields: [byUserId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([productId])
  @@index([technicianId])
  @@index([byUserId])
  @@index([mrfId])
  @@index([mrfItemId])
  @@index([createdAt])
}

// A correction to a stock count that isn't a receipt or a release — a
// physical recount, damage, or a data-entry fix. Recorded as a first-class
// transaction so the count can never change without an attributable reason.
model StockAdjustment {
  id        String           @id @default(cuid())
  refNo     String           @unique // ADJ-0001
  productId String
  product   Product          @relation(fields: [productId], references: [id])
  qtyBefore Int // what the system said at the time
  qtyAfter  Int // what it was corrected to
  delta     Int // qtyAfter - qtyBefore, signed
  reason    AdjustmentReason
  note      String?
  byUserId  String
  byUser    User             @relation(fields: [byUserId], references: [id])
  createdAt DateTime         @default(now())

  @@index([productId])
  @@index([byUserId])
  @@index([createdAt])
}

// Single-row table: the id is pinned to "singleton" so the row can be
// upserted safely and a second company profile can't be created by accident.
model CompanySettings {
  id                String   @id @default("singleton")
  name              String
  warehouseLocation String
  currency          String   @default("PHP — Philippine Peso (₱)")
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id])
}

// One row per ref-number prefix (MRF, SI, SO, ADJ, PO, PR, RPT). `nextRefNo`
// atomically increments `value` via a single upsert — replaces the old
// scan-existing-rows-then-insert approach, which needed Serializable
// isolation + heavy retries and still failed most of the time under real
// concurrent load (verified: 4/5 simultaneous MRF filings failed even with
// 8 retries). An atomic increment can't collide, so nothing to retry.
model RefCounter {
  prefix String @id
  value  Int    @default(0)
}

// Bytes for uploaded files while the Postgres BlobStore adapter is active.
// Rows here become dead weight once R2 is configured; see src/lib/storage.
model StoredBlob {
  key         String   @id // products/<uuid>.webp — same shape as an R2 object key
  contentType String
  size        Int
  bytes       Bytes
  createdAt   DateTime @default(now())
}

// NEW: Role definitions with configurable permissions
model RoleDef {
  id          String           @id @default(cuid())
  name        String           @unique // OWNER, ADMIN, WAREHOUSE_STAFF, TECHNICIAN, or custom
  displayName String
  description String?
  isSystem    Boolean          @default(false) // System roles can't be deleted
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// NEW: Permission definitions for roles
model RolePermission {
  id        String  @id @default(cuid())
  roleDefId String
  roleDef   RoleDef @relation(fields: [roleDefId], references: [id], onDelete: Cascade)
  module    String // dashboard, inventory, products, stock, etc.
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)

  @@unique([roleDefId, module])
  @@index([roleDefId])
  @@index([module])
}

// NEW: User-specific permission overrides
model Permission {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // Module this permission applies to
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // "Recorded Stock In — 24 × Galvanized Sheet 4x8"
  refNo     String // SI-0442 / SO-0290 / MRF-118 / RPT-088 / product code
  // NEW: true for account/permission/company-config changes — kept out of the
  // system-wide activity feed (everyone) and only shown on the full admin
  // audit log (Owner/Admin, unchanged/unfiltered as before this column existed).
  sensitive Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sensitive, createdAt])
}

/**
 * In-app inbox — polled by clients; works for multi-user Vercel + Neon.
 */
model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // mrf_filed | mrf_fulfilled | mrf_closed | low_stock | manual
  title        String
  body         String
  href         String
  refNo        String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  // NEW: set only for manually-sent notifications (type "manual") — who sent
  // it, shown to the recipient as "from <name>". Null for every automatic,
  // event-triggered notification (MRF filed, low stock, etc).
  senderUserId String?
  sender       User?     @relation("NotificationSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  WAREHOUSE_STAFF
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MrfStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum AdjustmentReason {
  MISCOUNT      // physical count didn't match the system
  DAMAGED       // goods damaged or otherwise unusable
  LOST          // missing, no explanation found
  FOUND         // stock located that the system didn't know about
  RETURN        // returned unused from a project
  CORRECTION    // fixing a data-entry mistake
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(ACTIVE)
  activities   ActivityLog[]
  stockIns     StockIn[]
  stockOuts    StockOut[]
  adjustments  StockAdjustment[]
  settingsEdits CompanySettings[]
  technician   Technician?
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Supplier {
  id       String @id @default(cuid())
  name     String @unique
  contact  String        // phone or email
  supplies String        // free-text description
  products Product[]
  stockIns StockIn[]
}

model Product {
  id         String  @id @default(cuid())
  code       String  @unique   // e.g. PIP-012 (prefix per category)
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  unit       String            // Pcs | Meter | ...
  amount     Decimal @db.Decimal(12,2)  // unit price, PHP
  stocks     Int     @default(0)
  minLevel   Int     @default(0)        // low-stock threshold
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  imageKey   String?           // R2 object key
  stockIns   StockIn[]
  stockOuts  StockOut[]
  mrfs       Mrf[]
  adjustments StockAdjustment[]
  @@index([categoryId])
  @@index([supplierId])
}

model Technician {
  id        String @id @default(cuid())
  empNo     String @unique     // EMP-0147
  name      String
  position  String             // HVAC Technician, Refrigeration Engineer
  userId    String? @unique    // links to the login account that files MRFs as this technician
  user      User? @relation(fields: [userId], references: [id])
  mrfs      Mrf[]
  stockOuts StockOut[]
}

model Mrf {                    // Material Request Form
  id           String @id @default(cuid())
  refNo        String @unique  // MRF-118
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  qty          Int
  project      String          // e.g. Northgate Cold Storage
  status       MrfStatus @default(PENDING)
  createdAt    DateTime @default(now())
  stockOut     StockOut?
  @@index([technicianId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

model StockIn {
  id         String @id @default(cuid())
  refNo      String @unique   // SI-0442
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  qty        Int
  byUserId   String
  byUser     User @relation(fields: [byUserId], references: [id])
  createdAt  DateTime @default(now())
  @@index([productId])
  @@index([supplierId])
  @@index([byUserId])
  @@index([createdAt])
}

model StockOut {
  id           String @id @default(cuid())
  refNo        String @unique // SO-0290
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  mrfId        String? @unique
  mrf          Mrf?   @relation(fields: [mrfId], references: [id])
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])
  qty          Int
  byUserId     String
  byUser       User @relation(fields: [byUserId], references: [id])
  createdAt    DateTime @default(now())
  @@index([productId])
  @@index([technicianId])
  @@index([byUserId])
  @@index([createdAt])
}

// A correction to a stock count that isn't a receipt or a release — a
// physical recount, damage, or a data-entry fix. Recorded as a first-class
// transaction so the count can never change without an attributable reason.
model StockAdjustment {
  id         String @id @default(cuid())
  refNo      String @unique   // ADJ-0001
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qtyBefore  Int              // what the system said at the time
  qtyAfter   Int              // what it was corrected to
  delta      Int              // qtyAfter - qtyBefore, signed
  reason     AdjustmentReason
  note       String?
  byUserId   String
  byUser     User @relation(fields: [byUserId], references: [id])
  createdAt  DateTime @default(now())
  @@index([productId])
  @@index([byUserId])
  @@index([createdAt])
}

// Single-row table: the id is pinned to "singleton" so the row can be
// upserted safely and a second company profile can't be created by accident.
model CompanySettings {
  id                String @id @default("singleton")
  name              String
  warehouseLocation String
  currency          String @default("PHP — Philippine Peso (₱)")
  updatedAt         DateTime @updatedAt
  updatedById       String?
  updatedBy         User? @relation(fields: [updatedById], references: [id])
}

model ActivityLog {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id])
  action    String            // "Recorded Stock In — 24 × Galvanized Sheet 4x8"
  refNo     String            // SI-0442 / SO-0290 / MRF-118 / RPT-088 / product code
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
